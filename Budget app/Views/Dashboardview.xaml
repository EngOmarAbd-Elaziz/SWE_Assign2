<UserControl x:Class="BudgetApp.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <StackPanel Margin="20">
        <TextBox Text="{Binding Amount}" />
        <TextBox Text="{Binding Category}" Margin="0,10,0,0"/>

        <Button Content="Add Expense"
                Command="{Binding AddExpenseCommand}"/>

        <Button Content="Show Limit"
                Command="{Binding ShowLimitCommand}"
                Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>